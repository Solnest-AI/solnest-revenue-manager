# ============================================================
#  solnest-revenue-manager — YOUR KEYS
#
#  Paste your keys after the = signs. No quotes. No spaces.
#      GOOD:  PRICELABS_API_KEY=abc123
#      BAD:   PRICELABS_API_KEY = "abc123"
#
#  Save this file, then run setup-keys.sh (Mac) or setup-keys.ps1 (Windows).
#  It fans these out to each connector without touching anything else.
#  NEVER paste a key into the chat window. NEVER commit this file.
# ============================================================

# ---- Required: your PMS and your pricing tool ----

# PriceLabs
# Get it: PriceLabs Dashboard -> Settings -> API Details -> Enable
PRICELABS_API_KEY=

# Hospitable
# Get it: https://my.hospitable.com/apps/api-access
HOSPITABLE_API_KEY=

# Hospitable webhook secret  (OPTIONAL — leave blank to skip)
# Get it: https://my.hospitable.com/apps/api-access
HOSPITABLE_WEBHOOK_SECRET=

# ---- Optional enrichment: skip any of these and the analysis still runs ----

# Turno — the long JWT (starts with eyJ)  (OPTIONAL — leave blank to skip)
# Turno's API is partner-gated. No access yet? Leave these blank.
# Get it: Turno partner dashboard
TURNO_API_TOKEN=

# Turno — the partner UUID  (OPTIONAL — leave blank to skip)
# Get it: Turno partner dashboard
TURNO_PARTNER_ID=

# Turno — which Turno account to talk to: sandbox or production.
# Leave this BLANK unless you mean it. Blank keeps whatever the Turno connector
# is already set to, which is sandbox (safe, no live data). Put `production`
# here only once you have verified the connection and want live data.
TURNO_ENV=

# AirROI (free key)  (OPTIONAL — leave blank to skip)
# Get it: https://www.airroi.com/api/developer/activate
AIRROI_API_KEY=

# RankBreeze session cookie (_godzilla_session)  (OPTIONAL — leave blank to skip)
# Get it: app.rankbreeze.com -> DevTools -> Cookies
RANKBREEZE_SESSION=
